rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Users ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) 
        && incoming().chatus == 5 
        && incoming().level == 1 
        && incoming().xp == 0;
      allow update: if isOwner(userId) 
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarParts', 'dailyLoginLast', 'chatus', 'xp', 'level', 'clubId', 'badges', 'debt', 'isPremium']);
    }

    // --- Clubs ---
    match /clubs/{clubId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        existing().ownerId == request.auth.uid || 
        exists(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid))
      );
    }

    match /clubs/{clubId}/members/{memberId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerId == request.auth.uid;
    }

    // --- Market ---
    match /market/{itemId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    // --- Competitions ---
    match /competitions/{compId} {
      allow read: if true;
      allow write: if false; // System only
    }

    // --- Chats ---
    match /chats/{roomId}/messages/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
    }

    // --- Projects ---
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().creatorId == request.auth.uid;
      allow update: if isOwner(existing().creatorId);
      allow delete: if isOwner(existing().creatorId);
    }
  }
}
